<Window x:Class="Memo.MonthSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Memo.Models"
        Title="Memo · 月度总结"
        Icon="Assets/app.ico"
        Width="384" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- 月份左右箭头 -->
        <Style x:Key="SumNav" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverFill}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文字小按钮：回到本月 / 关闭 -->
        <Style x:Key="SumTextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverFill}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 细滚动条，跟主卡片一致 -->
        <Style x:Key="SumScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource ScrollThumb}" CornerRadius="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 一行记录：状态点 + 优先级徽章 + 内容 + 日期 -->
        <DataTemplate x:Key="EntryTemplate" DataType="{x:Type models:SummaryEntry}">
            <Border x:Name="Row" CornerRadius="6" Padding="6,5" Margin="0,1" Background="Transparent"
                    MouseLeftButtonDown="Row_MouseLeftButtonDown" ToolTip="双击复制文字">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 完成的打勾，没完成的空心圈 -->
                    <TextBlock x:Name="Mark" Grid.Column="0" Text="○" Foreground="{DynamicResource TextFaint}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />

                    <Border x:Name="Badge" Grid.Column="1" CornerRadius="4" Width="18" Height="16"
                            Background="{DynamicResource MidBadge}" VerticalAlignment="Center" Margin="0,0,7,0">
                        <TextBlock x:Name="BadgeText" Text="{Binding PriorityText}"
                                   Foreground="{DynamicResource MidBrush}" FontSize="9.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock x:Name="ContentText" Grid.Column="2" Text="{Binding Content}"
                               Foreground="{DynamicResource TextPrimary}" FontSize="12"
                               TextWrapping="Wrap" LineHeight="17" LineStackingStrategy="BlockLineHeight"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="3" Text="{Binding DateText}" Foreground="{DynamicResource TextSubtle}"
                               FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource RowHoverFill}" />
                </Trigger>
                <DataTrigger Binding="{Binding PriorityKey}" Value="High">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource HighBadge}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource HighBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PriorityKey}" Value="Low">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource LowBadge}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource LowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="Mark" Property="Text" Value="✓" />
                    <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource CheckDoneFill}" />
                    <Setter TargetName="Mark" Property="FontSize" Value="10" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- 空白处按住就能拖着走 -->
    <Border Background="{DynamicResource DialogBackground}" CornerRadius="12" BorderThickness="1"
            BorderBrush="{DynamicResource DialogBorder}"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Border.Effect>
            <DynamicResource ResourceKey="DialogShadow" />
        </Border.Effect>

        <StackPanel Margin="16,12,16,14">
            <!-- 标题 -->
            <Grid Margin="0,0,0,10">
                <TextBlock Text="月度总结" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Content="✕" HorizontalAlignment="Right" Width="22" Height="22"
                        Foreground="{DynamicResource TextSubtle}" Background="Transparent" BorderThickness="0"
                        FontSize="11" Cursor="Hand" Click="Close_Click" />

                <!-- 双击复制后的小提示。叠在标题行右侧、不参与布局，所以出现和消失都不会把下面的内容顶来顶去 -->
                <Border x:Name="CopyToast" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,28,0" CornerRadius="6" Padding="7,2" Background="{DynamicResource AccentFill}"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="CopyToastText" Text="已复制" FontSize="10.5"
                               Foreground="{DynamicResource AccentForeground}" />
                </Border>
            </Grid>

            <!-- 月份导航：‹ 2026年10月 ›        回到本月 -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource SumNav}" Content="‹" Click="PrevMonth_Click"
                        ToolTip="上个月" />
                <TextBlock Grid.Column="1" x:Name="MonthLabel" Foreground="{DynamicResource TextPrimary}"
                           FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource SumNav}" Content="›" Click="NextMonth_Click"
                        ToolTip="下个月" />
                <Button Grid.Column="3" Style="{StaticResource SumTextButton}" Content="回到本月"
                        Click="CurrentMonth_Click" Margin="6,0,0,0" ToolTip="跳回当前月份" />
            </Grid>

            <!-- 三个数字：完成 / 新增 / 仍在处理 -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource InputBackground}" CornerRadius="8" Padding="10,7">
                    <StackPanel>
                        <TextBlock x:Name="DoneCountText" Foreground="{DynamicResource TextPrimary}"
                                   FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="本月完成" Foreground="{DynamicResource TextSubtle}" FontSize="10.5"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource InputBackground}" CornerRadius="8" Padding="10,7">
                    <StackPanel>
                        <TextBlock x:Name="CreatedCountText" Foreground="{DynamicResource TextPrimary}"
                                   FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="本月新增" Foreground="{DynamicResource TextSubtle}" FontSize="10.5"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="{DynamicResource InputBackground}" CornerRadius="8" Padding="10,7">
                    <StackPanel>
                        <TextBlock x:Name="OpenCountText" Foreground="{DynamicResource TextPrimary}"
                                   FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="仍在处理" Foreground="{DynamicResource TextSubtle}" FontSize="10.5"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 正文：本月完成 + 仍在处理，一起滚动 -->
            <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,2,0">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SumScrollBar}" />
                </ScrollViewer.Resources>

                <StackPanel>
                    <TextBlock x:Name="DoneHeader" Foreground="{DynamicResource TextSubtle}" FontSize="11"
                               Margin="2,0,0,4" />
                    <ItemsControl x:Name="DoneList" ItemTemplate="{StaticResource EntryTemplate}" />
                    <TextBlock x:Name="DoneEmpty" Text="这个月还没有完成的记录" Foreground="{DynamicResource TextDisabled}"
                               FontSize="11" Margin="2,3,0,3" />

                    <Border Height="1" Background="{DynamicResource SeparatorFill}" Margin="0,10,0,10" />

                    <TextBlock x:Name="OpenHeader" Foreground="{DynamicResource TextSubtle}" FontSize="11"
                               Margin="2,0,0,4" />
                    <ItemsControl x:Name="OpenList" ItemTemplate="{StaticResource EntryTemplate}" />
                    <TextBlock x:Name="OpenEmpty" Text="没有正在处理的事 ✨" Foreground="{DynamicResource TextDisabled}"
                               FontSize="11" Margin="2,3,0,3" />
                </StackPanel>
            </ScrollViewer>

            <TextBlock Text="「仍在处理」不分月份，是全部没做完的记录"
                       Foreground="{DynamicResource TextStatus}" FontSize="10" Margin="2,10,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>
