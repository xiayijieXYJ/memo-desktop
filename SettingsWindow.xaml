<Window x:Class="Memo.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memo · 设置"
        Icon="Assets/app.ico"
        Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- 主题二选一的小胶囊：选中项用主色填充，未选中透明，颜色全部跟随当前主题 -->
        <Style x:Key="ThemeChip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" Background="{DynamicResource InputBackground}"
                                Padding="0,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFill}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverFill}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 空白处按住就能拖着走：按钮/滑块自己会把鼠标事件吃掉，不会误触发拖动 -->
    <Border Background="{DynamicResource DialogBackground}" CornerRadius="12" BorderThickness="1"
            BorderBrush="{DynamicResource DialogBorder}"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Border.Effect>
            <DynamicResource ResourceKey="DialogShadow" />
        </Border.Effect>

        <StackPanel Margin="18,14,18,16">
            <Grid Margin="0,0,0,14">
                <TextBlock Text="设置" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold" />
                <Button Content="✕" HorizontalAlignment="Right" Width="22" Height="22"
                        Foreground="{DynamicResource TextSubtle}" Background="Transparent" BorderThickness="0"
                        FontSize="11" Cursor="Hand" Click="Close_Click" />
            </Grid>

            <!-- 主题三选一，点一下立即生效，也会记进 settings.json -->
            <TextBlock Text="主题" Foreground="{DynamicResource TextSubtle}" FontSize="11.5" Margin="0,0,0,5" />
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="DarkThemeChip" Grid.Column="0" Style="{StaticResource ThemeChip}"
                             Content="深色" GroupName="Theme" Click="ThemeChip_Click" Tag="Dark" />
                <RadioButton x:Name="LightThemeChip" Grid.Column="2" Style="{StaticResource ThemeChip}"
                             Content="浅色" GroupName="Theme" Click="ThemeChip_Click" Tag="Light" />
                <RadioButton x:Name="SepiaThemeChip" Grid.Column="4" Style="{StaticResource ThemeChip}"
                             Content="浅黄" GroupName="Theme" Click="ThemeChip_Click" Tag="Sepia" />
            </Grid>

            <TextBlock Text="卡片不透明度" Foreground="{DynamicResource TextSubtle}" FontSize="11.5" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="OpacitySlider" Grid.Column="0" Minimum="35" Maximum="100"
                        VerticalAlignment="Center" ValueChanged="OpacitySlider_ValueChanged" />
                <TextBlock x:Name="OpacityLabel" Grid.Column="1" Foreground="{DynamicResource TextSubtle}" FontSize="11"
                           VerticalAlignment="Center" Width="42" TextAlignment="Right" />
            </Grid>

            <CheckBox x:Name="PinnedCheck" Content="始终置顶（压在其他窗口上面）"
                      Foreground="{DynamicResource CheckboxLabelText}" FontSize="12" Margin="0,0,0,10"
                      Click="PinnedCheck_Click" />

            <CheckBox x:Name="ShowDoneCheck" Content="显示已完成条目"
                      Foreground="{DynamicResource CheckboxLabelText}" FontSize="12" Margin="0,0,0,10"
                      Click="ShowDoneCheck_Click" />

            <CheckBox x:Name="StartupCheck" Content="开机自动启动"
                      Foreground="{DynamicResource CheckboxLabelText}" FontSize="12" Margin="0,0,0,14"
                      Click="StartupCheck_Click" />

            <Border Background="{DynamicResource InputBackground}" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource TextSubtle}" FontSize="11" Text="唤出 / 收起卡片" Margin="0,0,0,3" />
                    <TextBlock Foreground="{DynamicResource TextPrimary}" FontSize="12.5" FontWeight="SemiBold" Text="Ctrl + Alt + M" />
                </StackPanel>
            </Border>

            <Button Content="打开数据目录" Foreground="{DynamicResource TextSubtle}" FontSize="11" Background="Transparent"
                    BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand"
                    Click="OpenDataDir_Click" Margin="0,0,0,12" />

            <TextBlock Text="数据保存在本机 SQLite 文件里，不上传任何地方。"
                       Foreground="{DynamicResource TextStatus}" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,14" />

            <Button Content="完成" HorizontalAlignment="Stretch" Height="30" Cursor="Hand"
                    Foreground="{DynamicResource AccentForeground}" FontSize="12.5" Click="Close_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource AccentFill}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>
