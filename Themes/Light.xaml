<!--
    浅色主题。key 必须和 Dark.xaml 完全一致，两文件成对维护。
    浅色下所有白色前景都要换成深色，否则白字落在浅底上会看不见。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 卡片与弹窗外壳 -->
    <SolidColorBrush x:Key="CardBackground" Color="#F7FBFCFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#1A1C1E24" />
    <SolidColorBrush x:Key="DialogBackground" Color="#FAFBFCFF" />
    <SolidColorBrush x:Key="DialogBorder" Color="#221C1E24" />
    <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="3" Opacity="0.22" Color="Black" />
    <DropShadowEffect x:Key="DialogShadow" BlurRadius="24" ShadowDepth="4" Opacity="0.24" Color="Black" />

    <!-- 文字层级 -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FF1C1E24" />
    <SolidColorBrush x:Key="TextSubtle" Color="#8C3C4048" />
    <SolidColorBrush x:Key="TextFaint" Color="#403C4048" />
    <SolidColorBrush x:Key="TextPlaceholder" Color="#591C1E24" />
    <SolidColorBrush x:Key="TextStatus" Color="#591C1E24" />
    <SolidColorBrush x:Key="TextCarried" Color="#803C4048" />
    <SolidColorBrush x:Key="TextDisabled" Color="#4D1C1E24" />
    <SolidColorBrush x:Key="CheckboxLabelText" Color="#E01C1E24" />
    <SolidColorBrush x:Key="DoneText" Color="#9AA0AC" />

    <!-- 容器填充与交互反馈 -->
    <SolidColorBrush x:Key="InputBackground" Color="#101C1E24" />
    <SolidColorBrush x:Key="HoverFill" Color="#141C1E24" />
    <SolidColorBrush x:Key="PressedFill" Color="#221C1E24" />
    <SolidColorBrush x:Key="RowHoverFill" Color="#0D1C1E24" />
    <SolidColorBrush x:Key="SeparatorFill" Color="#261C1E24" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#331C1E24" />
    <SolidColorBrush x:Key="SelectionFill" Color="#334C8DFF" />

    <!-- 右键菜单 -->
    <SolidColorBrush x:Key="MenuBackground" Color="#F2F7F9FC" />
    <SolidColorBrush x:Key="MenuBorder" Color="#261C1E24" />
    <SolidColorBrush x:Key="MenuForeground" Color="#F01C1E24" />
    <SolidColorBrush x:Key="MenuHighlight" Color="#2E4C8DFF" />

    <!-- 优先级配色：浅底上红/橙要压深一点才够对比 -->
    <SolidColorBrush x:Key="HighBrush" Color="#D92D20" />
    <SolidColorBrush x:Key="MidBrush" Color="#B45309" />
    <SolidColorBrush x:Key="LowBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="HighBadge" Color="#1FD92D20" />
    <SolidColorBrush x:Key="MidBadge" Color="#1FB45309" />
    <SolidColorBrush x:Key="LowBadge" Color="#1F2563EB" />

    <!-- 复选框 -->
    <SolidColorBrush x:Key="CheckRing" Color="#331C1E24" />
    <SolidColorBrush x:Key="CheckDoneFill" Color="#22C55E" />

    <!-- 主按钮 -->
    <SolidColorBrush x:Key="AccentFill" Color="#FF3B82F6" />
    <SolidColorBrush x:Key="AccentFillHover" Color="#FF2563EB" />
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFFFF" />

    <!-- 历史回看的只读提示条 -->
    <SolidColorBrush x:Key="HistoryBannerFill" Color="#1A4C8DFF" />
    <SolidColorBrush x:Key="HistoryBannerText" Color="#B3333B47" />

    <!-- 日历小窗 -->
    <SolidColorBrush x:Key="CalendarDayText" Color="#D91C1E24" />
    <SolidColorBrush x:Key="CalendarTodayFill" Color="#3322C55E" />
    <SolidColorBrush x:Key="CalendarTodayText" Color="#15803D" />
    <SolidColorBrush x:Key="CalendarDot" Color="#2563EB" />
    <SolidColorBrush x:Key="WeekHeaderText" Color="#594C5563" />

</ResourceDictionary>
