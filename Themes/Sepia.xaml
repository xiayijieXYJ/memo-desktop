<!--
    浅黄色（纸感）主题。key 必须和 Dark.xaml / Light.xaml 完全一致，三个文件成对维护。
    底色走暖米黄，文字用暖褐而不是纯黑——纯黑压在黄底上会有明显的"发脏"感；
    主色也跟着换成暖金棕，否则蓝色按钮在暖色卡片里会很跳。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 卡片与弹窗外壳 -->
    <SolidColorBrush x:Key="CardBackground" Color="#F7F8F5E8" />
    <SolidColorBrush x:Key="CardBorder" Color="#1A6B5E3E" />
    <SolidColorBrush x:Key="DialogBackground" Color="#FAFAF7EA" />
    <SolidColorBrush x:Key="DialogBorder" Color="#226B5E3E" />
    <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="3" Opacity="0.22" Color="Black" />
    <DropShadowEffect x:Key="DialogShadow" BlurRadius="24" ShadowDepth="4" Opacity="0.24" Color="Black" />

    <!-- 文字层级：暖褐，不用纯黑 -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FF3B3226" />
    <SolidColorBrush x:Key="TextSubtle" Color="#8C5C5140" />
    <SolidColorBrush x:Key="TextFaint" Color="#405C5140" />
    <SolidColorBrush x:Key="TextPlaceholder" Color="#593B3226" />
    <SolidColorBrush x:Key="TextStatus" Color="#593B3226" />
    <SolidColorBrush x:Key="TextCarried" Color="#80604F35" />
    <SolidColorBrush x:Key="TextDisabled" Color="#4D3B3226" />
    <SolidColorBrush x:Key="CheckboxLabelText" Color="#E03B3226" />
    <SolidColorBrush x:Key="DoneText" Color="#A89E8C" />

    <!-- 容器填充与交互反馈 -->
    <SolidColorBrush x:Key="InputBackground" Color="#106B5E3E" />
    <SolidColorBrush x:Key="HoverFill" Color="#146B5E3E" />
    <SolidColorBrush x:Key="PressedFill" Color="#226B5E3E" />
    <SolidColorBrush x:Key="RowHoverFill" Color="#0D6B5E3E" />
    <SolidColorBrush x:Key="SeparatorFill" Color="#266B5E3E" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#336B5E3E" />
    <SolidColorBrush x:Key="SelectionFill" Color="#33A1742A" />

    <!-- 右键菜单 -->
    <SolidColorBrush x:Key="MenuBackground" Color="#F2F7F3E3" />
    <SolidColorBrush x:Key="MenuBorder" Color="#266B5E3E" />
    <SolidColorBrush x:Key="MenuForeground" Color="#F03B3226" />
    <SolidColorBrush x:Key="MenuHighlight" Color="#2EA1742A" />

    <!-- 优先级配色：黄底上橙要压深一点，不然和底色糊在一起 -->
    <SolidColorBrush x:Key="HighBrush" Color="#C62A1B" />
    <SolidColorBrush x:Key="MidBrush" Color="#A8500A" />
    <SolidColorBrush x:Key="LowBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="HighBadge" Color="#1FC62A1B" />
    <SolidColorBrush x:Key="MidBadge" Color="#1FA8500A" />
    <SolidColorBrush x:Key="LowBadge" Color="#1F2563EB" />

    <!-- 复选框 -->
    <SolidColorBrush x:Key="CheckRing" Color="#336B5E3E" />
    <SolidColorBrush x:Key="CheckDoneFill" Color="#22C55E" />

    <!-- 主按钮：暖金棕，和白底浅色主题的蓝区分开 -->
    <SolidColorBrush x:Key="AccentFill" Color="#FFA1742A" />
    <SolidColorBrush x:Key="AccentFillHover" Color="#FF8A5F1E" />
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFFFF" />

    <!-- 历史回看的只读提示条 -->
    <SolidColorBrush x:Key="HistoryBannerFill" Color="#1AA1742A" />
    <SolidColorBrush x:Key="HistoryBannerText" Color="#B35C5140" />

    <!-- 日历小窗 -->
    <SolidColorBrush x:Key="CalendarDayText" Color="#D93B3226" />
    <SolidColorBrush x:Key="CalendarTodayFill" Color="#3322C55E" />
    <SolidColorBrush x:Key="CalendarTodayText" Color="#15803D" />
    <SolidColorBrush x:Key="CalendarDot" Color="#A1742A" />
    <SolidColorBrush x:Key="WeekHeaderText" Color="#59604F35" />

</ResourceDictionary>
