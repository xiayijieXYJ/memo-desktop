<!--
    深色主题（默认）。所有界面颜色都从这里取，MainWindow / SettingsWindow /
    DatePickerWindow 一律用 DynamicResource 引用，切换主题时才可能实时生效。
    新增颜色时两个主题文件都要加同名 key，否则切过去会变成"找不到资源"的透明色。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 卡片与弹窗外壳 -->
    <SolidColorBrush x:Key="CardBackground" Color="#F21C1E24" />
    <SolidColorBrush x:Key="CardBorder" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="DialogBackground" Color="#FA1C1E24" />
    <SolidColorBrush x:Key="DialogBorder" Color="#2AFFFFFF" />
    <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="Black" />
    <DropShadowEffect x:Key="DialogShadow" BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />

    <!-- 文字层级：主文字 / 次要 / 极淡 / 输入占位 / 状态栏 / 顺延标记 / 空态 -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextSubtle" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="TextFaint" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="TextPlaceholder" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="TextStatus" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="TextCarried" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="TextDisabled" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="CheckboxLabelText" Color="#E0FFFFFF" />
    <SolidColorBrush x:Key="DoneText" Color="#5A6070" />

    <!-- 容器填充与交互反馈 -->
    <SolidColorBrush x:Key="InputBackground" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="HoverFill" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="PressedFill" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="RowHoverFill" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="SeparatorFill" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="SelectionFill" Color="#664C8DFF" />

    <!-- 右键菜单（ContextMenu 在独立的弹出层里，也要能跟着主题走） -->
    <SolidColorBrush x:Key="MenuBackground" Color="#F22A2D36" />
    <SolidColorBrush x:Key="MenuBorder" Color="#2AFFFFFF" />
    <SolidColorBrush x:Key="MenuForeground" Color="#F0FFFFFF" />
    <SolidColorBrush x:Key="MenuHighlight" Color="#2E4C8DFF" />

    <!-- 优先级配色：高红 / 中橙 / 低蓝，徽章用同色低透明度底 -->
    <SolidColorBrush x:Key="HighBrush" Color="#FF5A5F" />
    <SolidColorBrush x:Key="MidBrush" Color="#FFB020" />
    <SolidColorBrush x:Key="LowBrush" Color="#4C8DFF" />
    <SolidColorBrush x:Key="HighBadge" Color="#26FF5A5F" />
    <SolidColorBrush x:Key="MidBadge" Color="#26FFB020" />
    <SolidColorBrush x:Key="LowBadge" Color="#264C8DFF" />

    <!-- 复选框 -->
    <SolidColorBrush x:Key="CheckRing" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="CheckDoneFill" Color="#4ADE80" />

    <!-- 主按钮（设置窗口的「完成」） -->
    <SolidColorBrush x:Key="AccentFill" Color="#3A4C8DFF" />
    <SolidColorBrush x:Key="AccentFillHover" Color="#554C8DFF" />
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFFFF" />

    <!-- 历史回看的只读提示条 -->
    <SolidColorBrush x:Key="HistoryBannerFill" Color="#1A4C8DFF" />
    <SolidColorBrush x:Key="HistoryBannerText" Color="#B3FFFFFF" />

    <!-- 日历小窗 -->
    <SolidColorBrush x:Key="CalendarDayText" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="CalendarTodayFill" Color="#3322C55E" />
    <SolidColorBrush x:Key="CalendarTodayText" Color="#86EFAC" />
    <SolidColorBrush x:Key="CalendarDot" Color="#4C8DFF" />
    <SolidColorBrush x:Key="WeekHeaderText" Color="#59FFFFFF" />

</ResourceDictionary>
