<Window x:Class="Memo.DatePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memo · 按日期安排"
        Icon="Assets/app.ico"
        Width="272" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- 顶部小箭头按钮 -->
        <Style x:Key="CalNav" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverFill}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 日期格子：有记录的日子加小圆点，今天用绿色描边 -->
        <Style x:Key="DayCell" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource CalendarDayText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="0,0,0,2" />
                                <Ellipse x:Name="Dot" Width="3" Height="3" Fill="{DynamicResource CalendarDot}"
                                         VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                         Margin="0,0,0,3" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverFill}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding HasRecord}" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CalendarTodayFill}" />
                                <Setter Property="Foreground" Value="{DynamicResource CalendarTodayText}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 空白处按住就能拖着走：日期格子和顶部按钮会自己吞掉鼠标事件 -->
    <Border Background="{DynamicResource DialogBackground}" CornerRadius="12" BorderThickness="1"
            BorderBrush="{DynamicResource DialogBorder}"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Border.Effect>
            <DynamicResource ResourceKey="DialogShadow" />
        </Border.Effect>

        <StackPanel Margin="12,10,12,12">
            <!-- 月份导航 -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource CalNav}" Content="‹" Click="PrevMonth_Click"
                        ToolTip="上个月" />
                <TextBlock Grid.Column="1" x:Name="MonthLabel" Foreground="{DynamicResource TextPrimary}" FontSize="12.5"
                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource CalNav}" Content="›" Click="NextMonth_Click"
                        ToolTip="下个月" />
                <Button Grid.Column="3" Style="{StaticResource CalNav}" Content="✕" Click="Close_Click"
                        ToolTip="关闭" Margin="6,0,0,0" />
            </Grid>

            <!-- 星期表头 -->
            <Grid x:Name="WeekHeader" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>

            <!-- 日期格子由代码填充 -->
            <Grid x:Name="DayGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="30" />
                    <RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="30" />
                </Grid.RowDefinitions>
            </Grid>

            <!-- 提示文字和「回到今天」各占一列，避免文字撑过来把按钮压在上面 -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="HintLabel" Foreground="{DynamicResource TextFaint}" FontSize="10"
                           VerticalAlignment="Center" Margin="0,0,6,0"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Text="圆点是有记录的日子，往后可提前安排" />
                <Button Grid.Column="1" Content="回到今天" VerticalAlignment="Center" Foreground="{DynamicResource TextSubtle}"
                        FontSize="10.5" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,2"
                        Click="Today_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
